# Supabase project settings
# Find these in your Supabase project: Settings -> API
# NEXT_PUBLIC_* variables are safe to expose to the browser.
# The service role key is SECRET - server-side only, never prefix it with NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only needed for admin scripts (seeding, moderation). Never used in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the deployed site (used for metadata / OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
