# Copy this file to .env.local and adjust if your backend runs elsewhere.
# .env.local is gitignored.

# Base URL of the piqnex-backend NestJS API (see ../piqnex-backend). Used
# server-side only (Server Components / Server Actions via src/lib/api-client.ts)
# - this app never calls the backend directly from browser JS, so it does NOT
# need a NEXT_PUBLIC_ prefix. Matches piqnex-backend/.env's PORT=4000 by default.
API_URL=http://localhost:4000

# Base URL of this site itself (used for metadata / OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
